HOST=0.0.0.0
PORT=9000
LOG_LEVEL=Info
RESEND_API_ENDPOINT=https://api.resend.com
RESEND_API_KEY=re_...
# Resend caps a batch request at 100 emails
API_EMAIL_BULK_SIZE=100
# Resend's default API rate limit is 2 requests per second
API_REQ_PER_SEC=2
# Svix signing secret of the Resend webhook (whsec_...). Webhooks are NOT verified when unset.
RESEND_WEBHOOK_SECRET=whsec_...
# Used when listmonk does not send a from address
#FROM_EMAIL=Newsletter <newsletter@example.com>
LISTMONK_API_ENDPOINT=http://localhost:9001
LISTMONK_API_USERNAME=admin
LISTMONK_API_PASSWORD=...
